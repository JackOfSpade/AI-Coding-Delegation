{
  "providers": {
    "anthropic": {
      "type": "anthropic-messages",
      "baseUrl": "https://api.anthropic.com",
      "keyRef": "keychain:offload-anthropic",
      "pricing": "anthropic-2026-10-19",
      "attemptTimeoutMs": 300000
    },
    "deepseek": {
      "type": "openai-chat",
      "baseUrl": "https://api.deepseek.com",
      "keyRef": "keychain:offload-deepseek",
      "pricing": "deepseek-2026-10-01",
      "attemptTimeoutMs": 300000
    },
    "openai": {
      "type": "openai-chat",
      "baseUrl": "https://api.openai.com/v1",
      "keyRef": "keychain:offload-openai",
      "pricing": "openai-2026-10-26",
      "attemptTimeoutMs": 300000
    }
  },
  "profiles": {
    "sonnet": { "provider": "openai", "model": "latest-terra", "fallback": "claude-sonnet" },
    "opus": { "provider": "openai", "model": "latest-sol", "fallback": "claude-opus" },
    "claude-sonnet": { "provider": "anthropic", "model": "latest-sonnet", "fallback": "flash" },
    "claude-opus": { "provider": "anthropic", "model": "latest-opus", "fallback": "flash" },
    "flash": { "provider": "deepseek", "model": "latest-flash" }
  },
  "default": "sonnet",
  "limits": { "maxTurns": 80, "timeoutMinutes": 30, "maxUsd": 2 },
  "verifier": { "interpreterRoots": [] }
}
